      "expectedMimeType": "text/csv"
    }
  },
  "error_responses": {
    "400_bad_request": {
      "description": "Invalid request body or parameters",
      "example": { "error": "Status must be pending, completed, or failed" }
    },
    "401_unauthorized": {
      "description": "Missing or invalid authentication",
      "example": { "error": "Unauthorized" }
    },
    "403_forbidden": {
      "description": "Insufficient permissions (non-admin user)",
      "example": { "error": "Forbidden: Requires admin privileges" }
    },
    "500_internal_error": {
      "description": "Server error",
      "example": { "error": "Failed to fetch users" }
    }
  },
  "test_workflow": {
    "step_1_admin_login": {
      "instruction": "Login as admin to get Bearer token",
      "copyTokenFrom": "$.admin_login.response.token"
    },
    "step_2_get_users": {
      "instruction": "List all users to see seeded test data",
      "useTokenFrom": "step_1"
    },
    "step_3_view_user_detail": {
      "instruction": "Click on any user to view their details and transactions",
      "useTokenFrom": "step_1"
    },
    "step_4_test_actions": {
      "instruction": "Test disable/delete users, update transaction status",
      "useTokenFrom": "step_1"
    },
    "step_5_check_dashboard": {
      "instruction": "View dashboard statistics and charts",
      "useTokenFrom": "step_1"
    },
    "step_6_export_data": {
      "instruction": "Export audit logs and investments as CSV",
      "useTokenFrom": "step_1"
    }
  }
}
