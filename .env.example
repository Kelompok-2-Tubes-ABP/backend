# ==============================================
# FinanceAPI Environment Configuration
# ==============================================

# Server Configuration
PORT=8080

# MongoDB Connection
# For local development: mongodb://localhost:27017
# For Docker: mongodb://mongodb:27017 (matches docker-compose.yml)
# For production: your MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017
# Alternative Atlas URI (uncomment and fill in for cloud):
# MONGO_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/?appName=FinanceAPI

# JWT Configuration
JWT_SECRET=dev-secret-change-in-production-32chars

# ==============================================
# AI Configuration (Optional)
# ==============================================

# Ollama (Local AI) - for chatbot
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# OpenAI (Cloud AI) - optional fallback for chatbot
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ==============================================
# External API Keys (Optional)
# ==============================================

# CoinGecko API - for crypto prices (free tier)
# Get your key at: https://www.coingecko.com/api
GECKO_API_KEY=

# Finnhub API - for stock prices (free tier)
# Get your key at: https://finnhub.io/
FINNHUB_API_KEY=

# ==============================================
# Email Configuration (Optional)
# ==============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=FinanceAPI
